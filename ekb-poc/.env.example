# Storage (MinIO locally; prod: s3://<bank-bucket>/ekb or hdfs://...)
LAKE_URI=s3://ekb-lake
S3_BUCKET=ekb-lake
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ekbminio
S3_SECRET_KEY=change_me_minio

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DB=ekb
PG_USER=ekb
PG_PASSWORD=change_me

# Trino (Starburst in prod) — data route, read-only user over the curated kb views
SQL_ENGINE_URL=http://trino:8080
SQL_CATALOG=postgresql
SQL_SCHEMA=kb
PG_READER_PASSWORD=change_me_reader

# Elasticsearch
ES_URL=http://elasticsearch:9200
ES_INDEX=ekb-chunks-v1
ES_INDEX_ALIAS=ekb-chunks
ES_USE_NATIVE_RRF=false

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# LLM (Ollama local, vLLM prod — both OpenAI-compatible)
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
# Hosted comparison (sends questions + retrieved passages outside the machine):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4.1-mini
#   LLM_API_KEY=<key>
# Embeddings always stay local, so switching the LLM needs no re-index.
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Workflow
WORKFLOW_ENGINE=builtin
NEAR_DUP_THRESHOLD=0.95

# Extraction: pymupdf (fast, default) or docling
EXTRACTOR=pymupdf
